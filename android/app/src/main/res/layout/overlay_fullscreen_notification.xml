<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CC000000"
    android:gravity="center"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="40dp"
    android:paddingBottom="40dp">

    <!-- Main notification container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/overlay_notification_background"
        android:padding="20dp"
        android:elevation="8dp">

        <!-- Header with icon and title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/overlay_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚨 URGENT: New Booking Request!"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#E53E3E"
                android:gravity="center" />

        </LinearLayout>

        <!-- Hidden body (kept for ID compatibility; not shown) -->
        <TextView
            android:id="@+id/overlay_body"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Booking details + map (map fills remaining space down to buttons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/booking_details_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/booking_customer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer: N/A"
                android:textSize="15sp"
                android:textColor="#1A202C"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/booking_customer_mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mobile: N/A"
                android:textSize="15sp"
                android:textColor="#1A202C"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/booking_work_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location: N/A"
                android:textSize="15sp"
                android:textColor="#1A202C"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/booking_work_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description: N/A"
                android:textSize="15sp"
                android:textColor="#1A202C"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/booking_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking For: N/A"
                android:textSize="15sp"
                android:textColor="#1A202C"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Route map fills all remaining space above ACCEPT/REJECT -->
            <FrameLayout
                android:id="@+id/booking_map_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#E2E8F0">

                <com.google.android.gms.maps.MapView
                    android:id="@+id/booking_route_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/booking_map_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="12dp"
                    android:text="Loading route…"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="#1D4ED8"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/booking_route_summary"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/booking_id"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Kept for binary compatibility; permanently hidden -->
            <LinearLayout
                android:id="@+id/booking_distance_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/booking_distance_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/booking_work_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/booking_work_original_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_accept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACCEPT"
                android:textColor="#FFFFFF"
                android:background="#4CAF50"
                android:layout_marginEnd="8dp"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="12dp" />

            <Button
                android:id="@+id/btn_reject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="REJECT"
                android:textColor="#FFFFFF"
                android:background="#F44336"
                android:layout_marginStart="8dp"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="12dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
